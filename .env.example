# 이 파일을 .env로 복사한 뒤 값을 채우세요.
#
#   cp .env.example .env
#
# .env는 gitignore 대상입니다. 실제 값을 커밋하지 마세요.

# ---------------------------------------------------------------------------
# 필수 — 값이 없으면 게이트웨이가 기동을 거부합니다
# ---------------------------------------------------------------------------

# JWT 서명 키. HS256이므로 32바이트 이상이어야 합니다.
#
# 기본값을 코드에 두지 않은 것은 의도입니다. 기본 키는 그대로 배포되고,
# 소스가 공개된 저장소에서 그것은 누구나 토큰을 위조할 수 있다는 뜻입니다.
#
#   생성:  openssl rand -base64 48
#   (Windows PowerShell)
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
PCAI_JWT_SECRET=

# ---------------------------------------------------------------------------
# 선택 — 비워두면 아래 기본값이 쓰입니다
# ---------------------------------------------------------------------------

# DB_NAME=personalcolor
# DB_USERNAME=personalcolor
# DB_PASSWORD=personalcolor

# 호스트에 여는 포트. 다른 프로젝트와 겹치면 여기서 바꾸세요.
# Redis와 ml-service는 호스트에 열지 않습니다 — Compose 네트워크 안에서만
# 쓰이고, 특히 6379는 충돌이 잦습니다.
# DB_PORT=5432
# BACKEND_PORT=8080
# WEB_PORT=3000

# 검출기 인스턴스 수. MediaPipe는 스레드 안전이 아니라 풀로 관리합니다.
# 늘리면 동시 처리량이 오르지만 인스턴스마다 모델을 따로 로드합니다.
# ML_DETECTOR_POOL_SIZE=2
