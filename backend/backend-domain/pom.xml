<?xml version="1.0" encoding="UTF-8"?>
<!--
  도메인 모듈 — 프레임워크를 모르는 순수 자바.

  의존성 목록이 비어 있다는 사실 자체가 이 모듈의 명세다. Spring도,
  JPA도, Jackson도 없다. 그래서 여기 있는 코드는 스프링 컨텍스트를
  띄우지 않고 밀리초 단위로 테스트된다.

  ml-service의 app/domain이 cv2와 fastapi를 임포트하지 않는 것과 같은
  원칙이다. 차이는 그쪽은 규율로, 이쪽은 빌드가 강제한다는 점이다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.personalcolor</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>backend-domain</artifactId>
  <name>backend-domain</name>
  <description>퍼스널 컬러 도메인 모델과 포트 — 프레임워크 의존 없음</description>

  <dependencies>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
